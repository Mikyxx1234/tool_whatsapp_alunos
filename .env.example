# =============================================================================
# Disparador WhatsApp - Variáveis de ambiente
# =============================================================================
# Copie este arquivo como `.env` e preencha com seus valores reais.
# NUNCA suba o arquivo .env para o repositório (ele já está no .gitignore).

# -----------------------------------------------------------------------------
# Servidor backend
# -----------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# Chave opcional para proteger rotas de escrita (upload, disparo, etc.).
# Se definida, envie no header x-api-key ou Authorization: Bearer <chave>.
# No frontend (Vite), use o mesmo valor em VITE_APP_API_KEY.
APP_API_KEY=
# VITE_APP_API_KEY=

# -----------------------------------------------------------------------------
# DataCrazy (CRM) — opcional
# -----------------------------------------------------------------------------
# Token Bearer fornecido pela DataCrazy (sem o prefixo "Bearer ").
DATACRAZY_API_KEY=
# URL base real conforme docs.datacrazy.io (servers do OpenAPI).
DATACRAZY_BASE_URL=https://api.g1.datacrazy.io
# Base do CRM (campos adicionais). Se omitido, deriva de DATACRAZY_BASE_URL (api → crm).
# DATACRAZY_CRM_BASE_URL=https://crm.g1.datacrazy.io
# Campo adicional no lead preenchido após cada disparo.
# DATACRAZY_ORIGEM_ATIVACAO_FIELD=origem_ativacao
# ID do campo (último segmento da URL ao editar no CRM).
# DATACRAZY_ORIGEM_ATIVACAO_FIELD_ID=3a22bd69-4578-4740-87c1-29e72fbbac22
# Modo de lookup: hybrid (default) | bulk_search | cache_first
# hybrid = só cache no preflight + busca API paralela no envio (recomendado 500+)
# DATACRAZY_ACTIVATION_LOOKUP_MODE=hybrid
# Buscas API paralelas por lead no envio (default 6)
# DATACRAZY_RESOLVE_CONCURRENCY=6
# Lote até N pessoas usa busca direta ?search= (default 5000).
# DATACRAZY_DIRECT_SEARCH_THRESHOLD=5000
# Rate limit global de GET/PUT no CRM (default 8/s — evita 429 no preflight).
# DATACRAZY_CRM_RATE_PER_SECOND=8
# Paralelismo da busca direta no preflight (default 4).
# DATACRAZY_DIRECT_SEARCH_CONCURRENCY=4
# Pausa entre lotes paralelos, em ms (default 250).
# DATACRAZY_DIRECT_SEARCH_DELAY_MS=250
# Cooldown após 429 antes de retentar (default 2000 ms).
# DATACRAZY_RATE_LIMIT_COOLDOWN_MS=2000
# Tentativas por termo no lote paralelo (default 5).
# DATACRAZY_SEARCH_MAX_ATTEMPTS=5
# Retry serial pós-429: tentativas e intervalo (default 8 / 500 ms).
# DATACRAZY_SERIAL_RETRY_MAX_ATTEMPTS=8
# DATACRAZY_SERIAL_RETRY_GAP_MS=500
# Envios simultâneos no loop de disparo (default 10).
# ACTIVATION_BATCH_CONCURRENCY=10
# Blocos automáticos quando o lote excede este tamanho (default 500).
# ACTIVATION_AUTO_CHUNK_SIZE=500
# Pausa entre blocos automáticos, em ms (default 30000 = 30s).
# ACTIVATION_CHUNK_PAUSE_MS=30000

# RGM institucional Cruzeiro EAD — prefixo de 2 dígitos (série histórica 20+; viradas 50…).
# INSTITUTIONAL_RGM_PREFIX_MIN=20
# INSTITUTIONAL_RGM_PREFIX_MAX=52

# -----------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — provedor recomendado para envio em massa
# -----------------------------------------------------------------------------
# Access Token permanente da Meta (System User token).
WHATSAPP_API_KEY=
# URL base da Graph API.
WHATSAPP_BASE_URL=https://graph.facebook.com/v20.0
# ID da conta WABA (WhatsApp Business Account). NÃO é o Phone Number ID!
WHATSAPP_BUSINESS_ACCOUNT_ID=
# ID do número de telefone — obrigatório para envio via Cloud API.
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# Providers (templates e envio)
# -----------------------------------------------------------------------------
#   whatsapp  → Meta Cloud API direto  (recomendado)
#   datacrazy → CRM DataCrazy
TEMPLATES_PROVIDER=whatsapp
MESSAGES_PROVIDER=whatsapp

# -----------------------------------------------------------------------------
# Throttling de envio
# -----------------------------------------------------------------------------
# Intervalo mínimo absoluto entre envios (segundos). O backend nunca usa
# valor menor que este, mesmo se o usuário escolher 0 no front.
# Recomendado pela Meta para marketing: 1–3s para preservar Quality Rating.
MIN_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Banco de dados (Postgres ou Supabase)
# -----------------------------------------------------------------------------
# Connection string completa. Exemplos:
#   Postgres local:  postgresql://postgres:senha@localhost:5432/disparador
#   Supabase:        postgresql://postgres.<ref>:senha@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Quando true, força SSL com rejectUnauthorized=false (necessário em Supabase/RDS).
DATABASE_SSL=true

# -----------------------------------------------------------------------------
# Webhook
# -----------------------------------------------------------------------------
# Verify token usado pela Meta no GET de verificação do webhook (/api/webhooks/whatsapp).
WEBHOOK_VERIFY_TOKEN=mude_esse_valor

# Janela (em horas) usada para correlacionar mensagens inbound a uma campanha.
WEBHOOK_MATCH_WINDOW_HOURS=168

# -----------------------------------------------------------------------------
# Régua Inteligente — Scheduler in-process
# -----------------------------------------------------------------------------
# Habilita o scheduler que processa scheduled_events a cada SCHEDULER_INTERVAL_MS.
# Em produção pode ser desligado se você rodar um worker externo no lugar.
SCHEDULER_ENABLED=true
# Intervalo entre ciclos (ms). 60000 = 60s.
SCHEDULER_INTERVAL_MS=60000
# Tamanho do lote reivindicado por ciclo (FOR UPDATE SKIP LOCKED).
SCHEDULER_BATCH_SIZE=50
# Após quantos minutos um lock 'processing' é considerado órfão e liberado.
SCHEDULER_STALE_LOCK_MIN=10

# -----------------------------------------------------------------------------
# Régua Inteligente — Email (canal complementar ao WhatsApp)
# -----------------------------------------------------------------------------
#   mock     → loga no console (default em dev)
#   resend   → integra com Resend (TODO [CURSOR])
#   smtp     → SMTP genérico (TODO [CURSOR])
#   sendgrid → SendGrid (TODO [CURSOR])
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS="Plataforma <noreply@suaempresa.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# Importação de bases (Bases → upload CSV/XLSX)
# -----------------------------------------------------------------------------
# Máximo de linhas por arquivo (padrão 120000; planilha provável evasão ~102k).
# BASE_UPLOAD_MAX_ROWS=120000

# -----------------------------------------------------------------------------
# Onda 2: cache persistente cpf → datacrazy_lead_id
# Reduz disparos de 10k leads de ~17min pra ~3s quando cache cheio.
# -----------------------------------------------------------------------------
# 1 (ligado) ou 0 (desligado). Default: 1.
DATACRAZY_CACHE_ENABLED=1
# Hora UTC do cron noturno de sync (0–23, default 3 = 03:00 UTC).
DATACRAZY_CACHE_SYNC_HOUR_UTC=3
# Safety limit de páginas do sync (default 2000, cobre ~200k leads).
DATACRAZY_CACHE_SYNC_MAX_PAGES=2000
# Quantos dias um lead pode ficar sem re-sync antes do cache ser invalidado.
# Default: 7.
DATACRAZY_CACHE_TTL_DAYS=7

# -----------------------------------------------------------------------------
# Anotação automática no DataCrazy a cada envio do disparador.
# Quando true (default), POST /api/v1/leads/{leadId}/notes a cada mensagem enviada.
# Desligue ('false') se a API do DataCrazy ficar instável.
# -----------------------------------------------------------------------------
# Grava anotação no card do lead após cada envio (default true).
DATACRAZY_DISPATCH_NOTE_ENABLED=true
# Desliga anotações automaticamente acima de N envios no mesmo lote (default 250).
# DATACRAZY_DISPATCH_NOTE_MAX_BATCH=250
# Lotes acima disso usam busca direta por CPF/e-mail (default 5000 — evita paginar CRM inteiro).
# DATACRAZY_DIRECT_SEARCH_THRESHOLD=5000
